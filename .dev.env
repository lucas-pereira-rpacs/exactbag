# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
FORCE_HTTPS=false
CORS_ORIGINS=http://localhost:3000
NATIVE_REGISTRATION_ENABLED=true
DEBUG_LOGS=true

# Database
# Leave unset to use the in-memory fallback during local development.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/exactbag?schema=public

# Dashboard
DASHBOARD_JWT_SECRET=local-development-only-change-before-production-9a82b7c1d4e6f0
DASHBOARD_JWT_EXPIRES=8h
DASHBOARD_ADMIN_NAME=Admin ExactBag
DASHBOARD_ADMIN_EMAIL=admin@exactbag.local
DASHBOARD_ADMIN_PASSWORD=admin123
DASHBOARD_ATEND_NAME=Atendente ExactBag
DASHBOARD_ATEND_EMAIL=atendente@exactbag.local
DASHBOARD_ATEND_PASSWORD=atend123

# Public form security
PUBLIC_FORM_LINK_SECRET=local-public-form-secret-change-before-production
PUBLIC_FORM_LINK_TTL_DAYS=30

# Email (use "smtp" with Mailpit locally or "resend" in production)
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=noreply@exactbag.com.br
EMAIL_FROM_NAME=ExactBag
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp
WHATSAPP_PROVIDER=meta
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v22.0
WHATSAPP_CPV_TEMPLATE=
WHATSAPP_VOLTA_TEMPLATE=

# Jotform
JOTFORM_API_KEY=
JOTFORM_FORM_ID=
JOTFORM_WEBHOOK_SECRET=
JOTFORM_FETCH_FIELD_NAMES=false
JOTFORM_POLL_INTERVAL_MS=60000

# Product download tokens
PRODUCT_DOWNLOAD_BASE_URL=https://downloads.exactbag.com
PRODUCT_TOKEN_EXPIRATION=24
PRODUCT_SECRET_KEY=local-product-secret-change-before-production

# MinIO (private object storage)
MINIO_PRIVATE_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PRIVATE_PORT=

# Background jobs and reports
JOB_MAX_CONCURRENT=10
JOB_PROCESS_INTERVAL_MS=250
REPORTS_ENABLED=false
VESPERA_HOUR_UTC=12
VESPERA_MINUTE_UTC=0
RETURN_REMINDER_HOUR_UTC=12
RETURN_REMINDER_MINUTE_UTC=0

# Support
SUPPORT_PHONE=+55 12 99758-3157
