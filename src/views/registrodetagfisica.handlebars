  var selectedCountry = COUNTRIES[0]; // Brasil default

  function flagImg(iso, alt) {
    return '<img src="https://flagcdn.com/w40/'+iso.toLowerCase()+'.png" class="flag-img" alt="'+(alt||iso)+'" />';
  }

  function renderCountryList(filter) {
    var list = document.getElementById('countryList');
    var f = (filter || '').toLowerCase();
    var filtered = f ? COUNTRIES.filter(function(c) {
      var name = t(c.nameKey);
      return name.toLowerCase().includes(f) || c.code.includes(f) || c.iso.toLowerCase().includes(f);
    }) : COUNTRIES;
    list.innerHTML = filtered.map(function(c) {
      return '<div class="country-item" data-iso="'+c.iso+'">' +
        '<span class="ci-flag">'+flagImg(c.iso, t(c.nameKey))+'</span>' +
        '<span class="ci-name">'+t(c.nameKey)+'</span>' +
        '<span class="ci-code">'+c.code+'</span>' +
      '</div>';
    }).join('');
    list.querySelectorAll('.country-item').forEach(function(el) {
      el.addEventListener('click', function() { selectCountry(el.dataset.iso); });
    });
  }

  function selectCountry(iso) {
    var c = COUNTRIES.find(function(x) { return x.iso === iso; });
    if (!c) return;
    selectedCountry = c;
    document.getElementById('countryFlag').innerHTML = flagImg(c.iso, t(c.nameKey));
    document.getElementById('countryCode').textContent = c.code;
    document.getElementById('countryDropdown').classList.remove('open');
    var phoneInput = document.getElementById('passengerPhone');
    var digits = phoneInput.value.replace(/\D/g, '').slice(0, c.maxDigits);
    phoneInput.value = c.mask(digits);
    phoneInput.placeholder = c === COUNTRIES[0] ? '11 99999-9999' : '';
    phoneInput.focus();
  }

  window.toggleCountryDropdown = function() {
    var dd = document.getElementById('countryDropdown');
    var isOpen = dd.classList.contains('open');
    if (isOpen) {
      dd.classList.remove('open');
    } else {
      dd.classList.add('open');
      document.getElementById('countrySearch').value = '';
      renderCountryList('');
      setTimeout(function() { document.getElementById('countrySearch').focus(); }, 50);
    }
  };

  document.getElementById('countrySearch').addEventListener('input', function(e) {
    renderCountryList(e.target.value);
  });

  // Close dropdown on outside click
  document.addEventListener('click', function(e) {
    var wrapper = document.querySelector('.phone-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
      document.getElementById('countryDropdown').classList.remove('open');
    }
  });

  // ========== PHONE MASK ==========
  document.getElementById('passengerPhone').addEventListener('input', function(e) {
    var digits = e.target.value.replace(/\D/g, '').slice(0, selectedCountry.maxDigits);
    e.target.value = digits.length ? selectedCountry.mask(digits).replace(/[\s\-]+$/, '') : '';
  });

