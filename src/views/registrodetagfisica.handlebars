  // ========== STEP NAVIGATION ==========
  window.nextStep = function() {
    if (!validateCurrentStep()) {
      focusFirstError();
      return;
    }
    if (currentStep < totalSteps) {
      showStep(currentStep + 1);
    }
  };

  window.prevStep = function() {
    if (currentStep > 1) {
      showStep(currentStep - 1);
    }
  };

  function showStep(step) {
    document.querySelectorAll('.step').forEach(function(el) { el.style.display = 'none'; });
    var target = document.querySelector('.step[data-step="' + step + '"]');
    if (target) target.style.display = 'block';
    currentStep = step;
    updateProgress();

    if (step === 3) renderBaggageItems();
    if (step === 4) renderSummary();

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress() {
    var labels = [
      t('step1Label'),
      t('step2Label'),
      t('step3Label'),
      t('step4Label')
    ];
    document.getElementById('stepLabel').textContent = labels[currentStep - 1];

    document.querySelectorAll('.progress-step').forEach(function(el) {
      var s = parseInt(el.dataset.step);
      el.classList.remove('active', 'done');
      if (s < currentStep) el.classList.add('done');
      if (s === currentStep) el.classList.add('active');
    });
  }

  // ========== VALIDATION ==========
  function setError(fieldId, msg) {
    var input = document.getElementById(fieldId);
    var errorEl = document.getElementById(fieldId + '-error');
    if (input) input.classList.add('error');
    var field = input && input.closest('.field');
    var termsCheck = input && input.closest('.terms-check');
    if (field) field.classList.add('has-error');
    if (termsCheck) termsCheck.classList.add('has-error');
    if (errorEl) { errorEl.textContent = msg; errorEl.classList.add('visible'); }
  }

  function clearError(fieldId) {
    var input = document.getElementById(fieldId);
    var errorEl = document.getElementById(fieldId + '-error');
    if (input) input.classList.remove('error');
    var field = input && input.closest('.field');
    var termsCheck = input && input.closest('.terms-check');
    if (field) field.classList.remove('has-error');
    if (termsCheck) termsCheck.classList.remove('has-error');
    if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('visible'); }
  }

  function clearAllErrors() {
    document.querySelectorAll('.error-msg').forEach(function(el) { el.textContent = ''; el.classList.remove('visible'); });
    document.querySelectorAll('.error').forEach(function(el) { el.classList.remove('error'); });
    document.querySelectorAll('.has-error').forEach(function(el) { el.classList.remove('has-error'); });
  }

  function val(id) { return (document.getElementById(id)?.value || '').trim(); }
  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function sunErrorMessage(code) { return code === 'SUN_EXPIRED' ? t('errSunExpired') : t('errSunInvalid'); }
  function focusFirstError() {
    var firstError = document.querySelector('.field.has-error, .photo-upload-zone.error, .terms-check.has-error, .error');
    if (!firstError) return;
    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (typeof firstError.focus === 'function' && firstError.matches('input, select, textarea, button')) firstError.focus();
  }

  function validateCurrentStep() {
    clearAllErrors();
    var valid = true;

    if (currentStep === 1) {
      if (val('passengerName').length < 3) { setError('passengerName', t('errNameReq')); valid = false; }

      var cpf = val('passengerCpf').replace(/\D/g, '');
      if (cpf && cpf.length !== 11) { setError('passengerCpf', t('errCpf')); valid = false; }

      var phone = val('passengerPhone').replace(/\D/g, '');
      if (phone.length < 7) { setError('passengerPhone', t('errPhone')); valid = false; }

      var email = val('passengerEmail');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('passengerEmail', t('errEmail')); valid = false; }

      if (val('emailConfirmation') !== email) { setError('emailConfirmation', t('errEmailMatch')); valid = false; }
      if (!sunConfirmed || !val('sunNumber')) {
        setError('sunNumber', t('errSunInvalid')); valid = false;
      }
    }

    if (currentStep === 2) {
      if (val('origin').length < 2) { setError('origin', t('errOrigin')); valid = false; }
      if (val('destination').length < 2) { setError('destination', t('errDest')); valid = false; }
    }

    if (currentStep === 3) {
      var qty = parseInt(document.getElementById('baggageQty').value) || 1;
      for (var i = 0; i < qty; i++) {
        if (!photoDataMap[i]) {
          setError('photoZone_' + i, t('errPhotoExt', { n: i + 1 }));
          valid = false;
        }
        if (!photoDataMap2[i]) {
          setError('photoZone_b_' + i, t('errPhotoAlt', { n: i + 1 }));
          valid = false;
        }
      }
    }

    if (currentStep === 4) {
      if (!document.getElementById('termsAccepted').checked) {
        setError('termsAccepted', t('errTerms'));
        valid = false;
      }
    }

    return valid;
  }

  window.confirmSun = async function() {
    var input = document.getElementById('sunNumber');
    var button = document.getElementById('confirmSunBtn');
    var sun = val('sunNumber').toUpperCase();
    input.value = sun;
    clearError('sunNumber');
    document.getElementById('sunNumber-success').classList.remove('visible');
    sunConfirmed = false;
    document.getElementById('insured').value = 'false';
    if (!sun) { setError('sunNumber', t('errSunInvalid')); return; }
    button.disabled = true;
    try {
      var response = await fetch(API_BASE + '/native/physical-tag/validate-sun', {
        method: 'POST', headers: Object.assign({ 'Content-Type': 'application/json' }, dashboardAuthHeaders()),
        body: JSON.stringify({ sunNumber: sun })
      });
      var result = await response.json();
      if (!response.ok || !result.valid) {
        setError('sunNumber', result.code ? sunErrorMessage(result.code) : (result.error || t('errSunInvalid')));
        return;
      }
      document.getElementById('insured').value = result.insured ? 'true' : 'false';
      sunConfirmed = true;
      input.classList.remove('error');
      document.getElementById('sunNumber-success').classList.add('visible');
    } catch (error) {
      setError('sunNumber', t('errSunInvalid'));
    } finally { button.disabled = false; }
  };

  document.getElementById('sunNumber').addEventListener('input', function(e) {
    e.target.value = e.target.value.toUpperCase();
    sunConfirmed = false;
    document.getElementById('insured').value = 'false';
    document.getElementById('sunNumber-success').classList.remove('visible');
    clearError('sunNumber');
  });

  // ========== CPF MASK ==========
  document.getElementById('passengerCpf').addEventListener('input', function(e) {
    var v = e.target.value.replace(/\D/g, '').slice(0, 11);
    if (v.length > 9) v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
    else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
    else if (v.length > 3) v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
    e.target.value = v;
  });

