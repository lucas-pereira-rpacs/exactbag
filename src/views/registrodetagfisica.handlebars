  // ========== PHOTO HANDLING ==========
  var photoDataMap = {};
  var photoDataMap2 = {};

  function handlePhoto(index, file, isSecond) {
    if (!file.type.startsWith('image/')) return;
    if (file.size > 5 * 1024 * 1024) { alert(t('errImgSize')); return; }

    var suffix = isSecond ? '_b' : '';
    var map = isSecond ? photoDataMap2 : photoDataMap;
    clearError('photoZone' + suffix + '_' + index);

    // Keep the original File. Object URLs are used only for the preview, so
    // the upload never becomes a Base64 string or gets converted to another
    // image format.
    map[index] = { file: file, previewUrl: URL.createObjectURL(file) };

    document.getElementById('photoZone' + suffix + '_' + index).style.display = 'none';
    var preview = document.getElementById('photoPreview' + suffix + '_' + index);
    preview.style.display = 'block';
    document.getElementById('photoImg' + suffix + '_' + index).src = map[index].previewUrl;
  }

  window.removePhoto = function(index, isSecond) {
    var suffix = isSecond ? '_b' : '';
    var map = isSecond ? photoDataMap2 : photoDataMap;
    if (map[index]?.previewUrl) URL.revokeObjectURL(map[index].previewUrl);
    delete map[index];
    document.getElementById('photoZone' + suffix + '_' + index).style.display = 'flex';
    document.getElementById('photoPreview' + suffix + '_' + index).style.display = 'none';
    document.getElementById('photoInput' + suffix + '_' + index).value = '';
  };

