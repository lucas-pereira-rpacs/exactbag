  // ========== FORM SUBMIT ==========
  document.getElementById('registrationForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    if (!validateCurrentStep()) return;

    var submitBtn = document.getElementById('submitBtn');
    var loading = document.getElementById('loadingOverlay');
    submitBtn.disabled = true;
    loading.classList.add('active');

    var qty = parseInt(document.getElementById('baggageQty').value) || 1;
    var baggageItems = [];
    for (var i = 0; i < qty; i++) {
      baggageItems.push({
        bagType: (document.getElementById('bagType_' + i)?.value || ''),
        color: (document.getElementById('color_' + i)?.value || '').trim(),
        brand: (document.getElementById('brand_' + i)?.value || '').trim(),
      });
    }

    var payload = {
      saleId: val('saleId') || null,
      isPhysicalTag: true,
      sunNumber: val('sunNumber'),
      insured: val('insured') === 'true',
      passengerName: val('passengerName'),
      passengerCpf: val('passengerCpf'),
      passengerEmail: val('passengerEmail'),
      emailConfirmation: val('emailConfirmation'),
      passengerPhone: selectedCountry.code + val('passengerPhone').replace(/\D/g, ''),
      transportType: document.querySelector('input[name="transportType"]:checked')?.value || 'aereo',
      origin: val('origin'),
      destination: val('destination'),
      airline: val('airline') || null,
      outboundDate: val('outboundDate') || null,
      returnDate: val('returnDate') || null,
      hasGpsTracker: document.querySelector('input[name="hasGpsTracker"]:checked')?.value === 'true',
      baggageQty: qty,
      termsAccepted: document.getElementById('termsAccepted').checked,
      baggageItems: baggageItems
    };

    var MAX_RETRIES = 2;
    var lastError = null;

    for (var attempt = 0; attempt <= MAX_RETRIES; attempt++) {
      try {
        var formData = new FormData();
        formData.append('registrationData', JSON.stringify(payload));
        for (var fileIndex = 0; fileIndex < qty; fileIndex++) {
          if (photoDataMap[fileIndex]) formData.append('imageData', photoDataMap[fileIndex].file);
          if (photoDataMap2[fileIndex]) formData.append('imageData2', photoDataMap2[fileIndex].file);
        }

        var response = await fetch(API_BASE + '/native/registro', {
          method: 'POST',
          headers: dashboardAuthHeaders(),
          body: formData
        });

        var result = await response.json();

        if (!response.ok || !result.success) {
          if (response.status === 400 && result.details) {
            var msgs = result.details.map(function(d) { return '• ' + d.message; }).join('\n');
            alert(t('submitInvalidData') + '\n\n' + msgs);
            submitBtn.disabled = false;
            loading.classList.remove('active');
            return;
          }
          throw new Error(result.error || t('submitError'));
        }

        // Sucesso
        loading.classList.remove('active');
        document.getElementById('formContainer').querySelector('form').style.display = 'none';
        document.querySelector('.progress-bar').style.display = 'none';
        document.getElementById('stepLabel').style.display = 'none';
        renderPhysicalTagSuccess();
        document.getElementById('successScreen').style.display = 'block';
        return;

      } catch (err) {
        lastError = err;
        if (err instanceof TypeError && attempt < MAX_RETRIES) {
          document.getElementById('loadingText').textContent = t('submitRetry');
          await new Promise(function(r) { setTimeout(r, 2000 * (attempt + 1)); });
          document.getElementById('loadingText').textContent = t('submitProcessing');
          continue;
        }
        break;
      }
    }

    if (lastError instanceof TypeError) {
      alert(t('submitNoConnection'));
    } else {
      alert((lastError?.message || t('submitError')) + '\n\n' + t('submitGenericError'));
    }
    submitBtn.disabled = false;
    loading.classList.remove('active');
  });

  // ========== TRIP TYPE TOGGLE ==========
  document.querySelectorAll('input[name="tripType"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var isOneWay = this.value === 'oneway';
      document.getElementById('returnDateField').style.display = isOneWay ? 'none' : '';
      if (isOneWay) document.getElementById('returnDate').value = '';
    });
  });

  function hydratePrefilledPhone() {
    var phoneInput = document.getElementById('passengerPhone');
    var rawPhone = phoneInput.value.trim();
    if (!rawPhone) return;

    var country = COUNTRIES[0];
    var rawDigits = rawPhone.replace(/\D/g, '');
    if (rawPhone.charAt(0) === '+') {
      country = COUNTRIES
        .slice()
        .sort(function(a, b) { return b.code.length - a.code.length; })
        .find(function(item) { return rawPhone.indexOf(item.code) === 0; }) || country;
      rawPhone = rawPhone.slice(country.code.length);
    } else if (rawDigits.length > country.maxDigits) {
      var detectedCountry = COUNTRIES
        .slice()
        .sort(function(a, b) { return b.code.length - a.code.length; })
        .find(function(item) {
          var countryDigits = item.code.replace(/\D/g, '');
          var nationalDigits = rawDigits.slice(countryDigits.length);
          return rawDigits.indexOf(countryDigits) === 0 &&
            nationalDigits.length >= 7 && nationalDigits.length <= item.maxDigits;
        });
      if (detectedCountry) {
        country = detectedCountry;
        var countryDigits = country.code.replace(/\D/g, '');
        rawPhone = rawDigits.slice(countryDigits.length);
      }
    }

    selectedCountry = country;
    document.getElementById('countryFlag').innerHTML = flagImg(country.iso, t(country.nameKey));
    document.getElementById('countryCode').textContent = country.code;
    var digits = rawPhone.replace(/\D/g, '').slice(0, country.maxDigits);
    phoneInput.value = country.mask(digits).replace(/[\s\-]+$/, '');
  }

  // ========== INIT ==========
  applyLang();
  showStep(1);
  hydratePrefilledPhone();

  // Auto-set baggage qty from URL and lock for non-admin
  var qtySelect = document.getElementById('baggageQty');
  var prefilledQty = parseInt(qtySelect.dataset.prefilledQty) || 0;
  var initialQty = URL_QTY || prefilledQty;
  if (initialQty >= 1 && initialQty <= 5) {
    qtySelect.value = initialQty;
  }
  if (!IS_ADMIN) {
    var qtyEl = document.getElementById('baggageQty');
    qtyEl.disabled = true;
    qtyEl.style.opacity = '0.7';
    qtyEl.style.cursor = 'not-allowed';
    qtyEl.style.pointerEvents = 'none';
  }
  renderBaggageItems();

})();
</script>

</body>
</html>
