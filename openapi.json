    "/jobs/{jobId}": {
      "get": {
        "tags": ["Acompanhamento"],
        "summary": "Consultar status de uma venda",
        "description": "Retorna o status do processamento usando o `jobId` recebido ao enviar a venda.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "description": "ID do job retornado no POST /webhooks/sales",
            "schema": { "type": "string", "format": "uuid", "example": "11111111-1111-4111-8111-111111111111" }
          }
        ],
        "responses": {
          "200": {
            "description": "Status do processamento",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "format": "uuid", "example": "11111111-1111-4111-8111-111111111111" },
                    "status": { "type": "string", "enum": ["pending", "running", "retrying", "completed", "failed"], "example": "completed" },
                    "createdAt": { "type": "string", "format": "date-time" },
                    "completedAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "404": { "description": "Job não encontrado" }
        }
      }
    },
    "/jobs": {
      "get": {
        "tags": ["Acompanhamento"],
        "summary": "Listar todos os jobs",
        "description": "Lista os jobs de processamento do parceiro autenticado.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Quantidade de resultados (máx. 100)",
            "schema": { "type": "integer", "default": 20, "maximum": 100 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Deslocamento para paginação",
            "schema": { "type": "integer", "default": 0 }
          }
        ],
        "responses": {
          "200": { "description": "Lista de jobs retornada" },
          "401": { "description": "API Key ausente ou inválida" }
        }
      }
    },
    "/webhooks/register": {
      "post": {
        "tags": ["Webhook do Parceiro"],
        "summary": "Cadastrar URL de callback",
        "description": "Define a URL que receberá notificações quando eventos ocorrerem.\n\n**Eventos enviados à sua URL:**\n\n1. **`customer.registration.completed`** — Passageiro completou o registro de bagagem:\n```json\n{\n  \"event\": \"customer.registration.completed\",\n  \"saleId\": \"clxyz123abc\",\n  \"partnerId\": \"INFOTRAVEL\",\n  \"customerName\": \"Maria Santos\",\n  \"customerEmail\": \"maria.santos@email.com\",\n  \"submissionId\": \"clxyz456def\",\n  \"completedAt\": \"2026-04-10T14:30:00Z\",\n  \"signature\": \"hmac-sha256-hex...\"\n}\n```\n\n2. **`sale.cancelled`** — Venda foi cancelada:\n```json\n{\n  \"event\": \"sale.cancelled\",\n  \"saleId\": \"RES-2026-78901\",\n  \"partnerId\": \"INFOTRAVEL\",\n  \"customerName\": \"Maria Santos\",\n  \"customerEmail\": \"maria.santos@email.com\",\n  \"cancelledAt\": \"2026-04-08T10:00:00Z\",\n  \"refundType\": \"integral\",\n  \"reason\": \"Cliente desistiu\",\n  \"signature\": \"hmac-sha256-hex...\"\n}\n```\n\n**Verificação da assinatura (recomendado):**\nO campo `signature` é gerado com HMAC-SHA256 usando sua API Key como secret sobre o payload JSON. Também enviado no header `X-ExactBag-Signature`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["webhookUrl"],
                "properties": {
                  "webhookUrl": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://api.seusite.com.br/callbacks/exactbag"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook registrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Webhook registrado com sucesso" },
                    "webhookUrl": { "type": "string", "example": "https://api.seusite.com.br/callbacks/exactbag" }
                  }
                }
              }
            }
          },
          "400": { "description": "URL inválida" },
          "401": { "description": "API Key ausente ou inválida" }
        }
      }
    },
    "/webhooks/status": {
      "get": {
        "tags": ["Webhook do Parceiro"],
        "summary": "Verificar webhook cadastrado",
        "description": "Consulta se o parceiro possui URL de callback configurada.",
        "responses": {
          "200": {
            "description": "Status retornado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "webhookUrl": { "type": "string", "nullable": true, "example": "https://api.seusite.com.br/callbacks/exactbag" },
                    "configured": { "type": "boolean", "example": true },
                    "isSandbox": { "type": "boolean", "example": false, "description": "Se true, notificações (email/WhatsApp) são simuladas e NÃO enviadas. Ideal para testes." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/unregister": {
      "delete": {
        "tags": ["Webhook do Parceiro"],
        "summary": "Remover webhook",
        "description": "Remove a URL de callback. Sem webhook, o parceiro não receberá notificações automáticas.",
        "responses": {
          "200": { "description": "Webhook removido com sucesso" },
          "401": { "description": "API Key ausente ou inválida" }
        }
      }
    },
    "/webhooks/sales/{saleId}/cancel": {
      "post": {
        "tags": ["Cancelamento"],
        "summary": "Cancelar uma venda",
        "description": "Cancela uma venda e calcula o estorno automaticamente.\n\n**Regras de estorno:**\n- **≥48h antes do voo** → Estorno integral (100%)\n- **<48h antes do voo** → Estorno parcial (50%)\n- **Status `reserva` (não paga)** → Sem estorno\n\n**O que acontece ao cancelar:**\n1. Status da venda muda para `cancelada`\n2. Link do formulário é invalidado (cliente não consegue mais acessar)\n3. Notificações de véspera são canceladas\n4. Callback `sale.cancelled` é enviado ao parceiro (se webhook configurado)",
        "parameters": [
          {
            "name": "saleId",
            "in": "path",
            "required": true,
            "description": "ID da venda no sistema do parceiro (mesmo `saleId` enviado no POST /webhooks/sales)",
            "schema": { "type": "string", "example": "RES-2026-78901" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "Motivo do cancelamento (opcional)",
                    "example": "Cliente desistiu da viagem"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Venda cancelada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Venda cancelada com sucesso" },
                    "sale": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "saleId": { "type": "string", "example": "RES-2026-78901" },
                        "customerName": { "type": "string", "example": "Maria Santos" },
                        "status": { "type": "string", "example": "cancelada" },
                        "cancelledAt": { "type": "string", "format": "date-time" }
                      }
                    },
                    "refundType": { "type": "string", "enum": ["integral", "parcial", "nenhum"], "example": "integral" }
                  }
                }
              }
            }
          },
          "404": { "description": "Venda não encontrada" },
          "409": { "description": "Venda já está cancelada" },
          "422": { "description": "Status da venda não permite cancelamento" },
          "401": { "description": "API Key ausente ou inválida" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Status"],
        "summary": "Verificar se a API está online",
        "description": "Não requer autenticação.",
        "security": [],
        "responses": {
          "200": {
            "description": "API online",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ExactBag API Online" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaleRequest": {
        "type": "object",
        "required": ["partnerId", "saleId", "customerName", "customerEmail", "customerPhone"],
        "properties": {
          "partnerId": {
            "type": "string",
            "description": "Identificador do parceiro (fornecido pela ExactBag)",
            "example": "INFOTRAVEL"
          },
          "saleId": {
            "type": "string",
            "description": "ID da venda no sistema do parceiro (usado para evitar duplicidade)",
            "example": "RES-2026-78901"
          },
          "customerName": {
            "type": "string",
            "description": "Nome completo do passageiro",
            "example": "Maria Santos"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "description": "Email do passageiro (receberá o link do formulário)",
            "example": "maria.santos@email.com"
          },
          "customerPhone": {
            "type": "string",
            "description": "Telefone com DDI+DDD (receberá WhatsApp)",
            "example": "+5511988887777"
          },
          "roundTrip": {
            "type": "boolean",
            "description": "Viagem de ida e volta?",
            "default": false,
            "example": true
          },
          "outboundDate": {
            "type": "string",
            "format": "date",
            "description": "Data de ida (formato YYYY-MM-DD)",
            "example": "2026-04-15"
          },
          "returnDate": {
            "type": "string",
            "format": "date",
            "description": "Data de volta (apenas se roundTrip=true)",
            "example": "2026-04-22"
          },
          "baggageQty": {
            "type": "integer",
            "description": "Quantidade de bagagens contratadas",
            "default": 1,
            "minimum": 1,
            "example": 2
          },
          "hasInsurance": {
            "type": "boolean",
            "description": "Indica se a venda inclui seguro de bagagem. Propaga para o registro do passageiro e fica visível no painel.",
            "default": false,
            "example": true
          },
          "productCode": {
            "type": "string",
            "description": "Product code for the sale. To trigger the physical TAG flow, provide `5383660` (Essencial X2) or `5383661` (Cover X2). If omitted, the sale uses the digital flow.",
            "enum": ["5383660", "5383661"],
            "example": "5383660"
          }
        }
      },
      "InsuranceAvailabilityResponse": {
        "type": "object",
        "properties": {
          "insuranceAvail": {
            "type": "array",
            "description": "Lista de produtos ExactBag disponíveis para a pesquisa realizada.",
            "items": { "$ref": "#/components/schemas/InsuranceAvailItem" }
          }
        }
      },
      "InsuranceAvailItem": {
        "type": "object",
        "properties": {
          "insurance": { "$ref": "#/components/schemas/InsuranceProduct" },
          "fares": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InsuranceFare" }
          },
          "names": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InsuranceName" }
          },
          "cancellationPolicies": { "$ref": "#/components/schemas/CancellationPolicies" }
        }
      },
      "InsuranceProduct": {
        "type": "object",
        "properties": {
          "provider": { "type": "string", "example": "ExactBag" },
          "key": { "type": "string", "description": "Chave de sessão da disponibilidade", "example": "445DEHQ2U1VO8IID8S" },
          "code": { "type": "string", "description": "Código do produto ExactBag", "example": "5383656" },
          "name": { "type": "string", "example": "ASSISTENCIA DE BAGAGEM EXACTBAG COVER - PROTEÇÃO COMPLETA COM SEGURO EXTRAVIO R$ 2.500" },
          "startDate": { "type": "string", "format": "date-time", "example": "2026-12-01T00:00:00-03:00" },
          "endDate": { "type": "string", "format": "date-time", "example": "2026-12-08T00:00:00-03:00" },
          "description": { "type": "string", "description": "Descrição comercial do produto" },
          "image": { "type": "string", "format": "uri", "description": "Imagem/arte do produto para exibição no parceiro" },
          "unique": { "type": "boolean", "example": false },
          "onRequest": { "type": "boolean", "example": false },
          "providerDetail": { "$ref": "#/components/schemas/InsuranceProviderDetail" },
          "coverages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InsuranceCoverage" }
          },
          "usagePolicy": {
            "type": "array",
            "description": "Políticas de uso do produto ExactBag",
            "items": { "type": "string" }
          },
          "keyDetail": { "type": "string", "description": "Chave de detalhe do produto para uso no fluxo de reserva", "example": "NTM4MzY1NiMy" }
        }
      },
      "InsuranceProviderDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 26908 },
          "externalCode": { "type": "string", "example": "" },
          "name": { "type": "string", "example": "ExactBag" },
          "localTrip": { "type": "boolean", "example": false }
        }
      },
      "InsuranceCoverage": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "2898" },
          "name": { "type": "string", "example": "assistencia de bagagem com seguro" },
          "minPrice": { "type": "string", "example": "R$ 2.500,00" },
          "maxPrice": { "type": "string", "example": "R$ 2.500,00" }
        }
      },
      "InsuranceFare": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "FARE" },
          "price": { "$ref": "#/components/schemas/InsurancePriceWithExchange" },
          "priceSale": { "$ref": "#/components/schemas/InsurancePrice" },
          "priceNet": { "$ref": "#/components/schemas/InsurancePrice" },
          "discount": { "type": "boolean", "example": false }
        }
      },
      "InsurancePrice": {
        "type": "object",
        "properties": {
          "currency": { "type": "string", "example": "BRL" },
          "amount": { "type": "number", "format": "float", "example": 44.9 }
        }
      },
      "InsurancePriceWithExchange": {
        "allOf": [
          { "$ref": "#/components/schemas/InsurancePrice" },
          {
            "type": "object",
            "properties": {
              "exchange": { "type": "number", "format": "float", "example": 1.0 }
            }
          }
        ]
      },
      "InsuranceName": {
        "type": "object",
        "properties": {
          "age": { "type": "integer", "example": 30 },
          "type": { "type": "string", "enum": ["ADT", "CHD"], "example": "ADT" },
          "gender": { "type": "string", "example": "UNDEFINED" },
          "isMain": { "type": "boolean", "example": false }
        }
      },
      "CancellationPolicies": {
        "type": "object",
        "properties": {
          "refundable": { "type": "boolean", "example": false },
          "immediateFine": { "type": "boolean", "example": false },
          "penalties": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CancellationPenalty" }
          }
        }
      },
      "CancellationPenalty": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Não reembolsável após emissão do CPV" },
          "description": { "type": "string", "example": "O serviço não é reembolsável após a emissão do CPV." },
          "price": { "$ref": "#/components/schemas/InsurancePrice" }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Informe sua API Key: Bearer SUA_API_KEY"
      }
    }
  }
}
